[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="collectible"

[rendering]

renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/16_bits=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=true
environment/defaults/default_clear_color=Color(0.55, 0.68, 0.82, 1)
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
environment/ssao_quality=2
environment/ssil_quality=2
environment/glow/upscale_mode=1
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=128
